# ============================================================
# Intelligent Power Monitoring & Distribution System
# Example Environment Configuration
#
# Copy this file to collector.env and replace placeholder values
# as needed for your environment.
#
# DO NOT commit collector.env to Git.
# ============================================================


# ------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------

ES_ENDPOINT=https://your-elasticsearch-endpoint
ES_API_KEY=your-api-key-here

ES_INDEX=capstone-cx002-node-metrics
POD_ES_INDEX=capstone-cx002-pod-metrics
POD_STATUS_SUMMARY_INDEX=capstone-cx002-pod-status-summary

ANOMALY_ES_INDEX=capstone-cx002-anomalies
HEALTH_INDEX=capstone-cx002-health-status


# ------------------------------------------------------------
# Kubernetes / Prometheus
# ------------------------------------------------------------

PROMETHEUS_URL=http://localhost:30900
NODE_NAME=cx-002

POD_INTERVAL_SECONDS=15


# ------------------------------------------------------------
# Anomaly Detection
# ------------------------------------------------------------

ANOMALY_INTERVAL_SECONDS=30
ANOMALY_SUPPRESSION_MINUTES=30
HEALTH_LOOKBACK_MINUTES=35


# ------------------------------------------------------------
# Incident Management
# ------------------------------------------------------------

INCIDENT_MANAGER_INTERVAL_SECONDS=15
INCIDENT_MANAGER_BATCH_SIZE=100


# ------------------------------------------------------------
# Forecast Training
# ------------------------------------------------------------

FORECAST_TRAINING_DAYS=37
FORECAST_MIN_SAMPLE_COUNT=10
FORECAST_INTERVAL_MINUTES=5
FORECAST_HORIZON_HOURS=24
FORECAST_CONFIDENCE_INTERVAL=0.95


# ------------------------------------------------------------
# Forecast Evaluation
# ------------------------------------------------------------

FORECAST_EVALUATION_DELAY_MINUTES=10
FORECAST_EVALUATION_LOOKBACK_DAYS=7
FORECAST_EVALUATION_INTERVAL_MINUTES=5
FORECAST_EVALUATION_PAGE_SIZE=500
FORECAST_MIN_ACTUAL_SAMPLES=5


# ------------------------------------------------------------
# Forecast Data Processing
# ------------------------------------------------------------

FORECAST_BATCH_SIZE=500


# ------------------------------------------------------------
# Forecast Alert Thresholds
# ------------------------------------------------------------

FORECAST_CAPACITY_WARNING_PERCENT=60
FORECAST_CAPACITY_CRITICAL_PERCENT=90

FORECAST_ACCURACY_WARNING_PERCENT=90
FORECAST_ACCURACY_CRITICAL_PERCENT=85

FORECAST_COVERAGE_WARNING_PERCENT=80
FORECAST_COVERAGE_CRITICAL_PERCENT=70

FORECAST_ALERT_EVALUATION_WINDOW_HOURS=24


# ------------------------------------------------------------
# Scenario / Capacity Planning
# ------------------------------------------------------------

FORECAST_SCENARIO_MODE=false
CIRCUIT_CAPACITY_WATTS=1440